{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "规则检索与激活 A/B 结果",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "variant",
    "process_exit_code",
    "semantic_assertions_passed",
    "semantic_assertions_total",
    "semantic_pass",
    "authority_confusion",
    "wrong_stop_or_escalation",
    "wrong_execution",
    "files_read",
    "tool_calls",
    "retrieved_rule_keys",
    "fallback_required",
    "fallback_reason",
    "failure_classification"
  ],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["A", "B"]},
    "process_exit_code": {"type": ["integer", "null"]},
    "semantic_assertions_passed": {"type": ["integer", "null"], "minimum": 0},
    "semantic_assertions_total": {"type": "integer", "minimum": 1},
    "semantic_pass": {"type": ["boolean", "null"]},
    "authority_confusion": {"type": ["boolean", "null"]},
    "wrong_stop_or_escalation": {"type": ["boolean", "null"]},
    "wrong_execution": {"type": ["boolean", "null"]},
    "files_read": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "tool_calls": {"type": ["integer", "null"], "minimum": 0},
    "retrieved_rule_keys": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "fallback_required": {"type": ["boolean", "null"]},
    "fallback_reason": {"type": ["string", "null"]},
    "failure_classification": {
      "type": ["string", "null"],
      "enum": [
        null,
        "discovery-or-activation",
        "selection-or-conflict",
        "instruction-density",
        "misleading-or-stale-context",
        "true-rule-gap",
        "runtime-or-environment",
        "none"
      ]
    },
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "wall_clock_ms": {"type": ["integer", "null"], "minimum": 0},
    "file_read_count": {"type": ["integer", "null"], "minimum": 0},
    "rule_bytes_or_lines_read": {"type": ["integer", "null"], "minimum": 0},
    "query_invocations": {"type": ["integer", "null"], "minimum": 0},
    "model": {"type": ["string", "null"]},
    "reasoning_effort": {"type": ["string", "null"]},
    "client_turn_model": {"type": ["string", "null"]},
    "requested_model": {"type": ["string", "null"]},
    "requested_reasoning_effort": {"type": ["string", "null"]},
    "runtime_facts_status": {
      "enum": ["observed", "unavailable", "ambiguous"]
    },
    "runtime_facts_source": {"type": ["string", "null"]},
    "pair_fairness_status": {
      "enum": ["pending", "comparable", "insufficient", "mismatch"]
    },
    "grading_status": {"enum": ["pending", "scored"]}
  }
}
