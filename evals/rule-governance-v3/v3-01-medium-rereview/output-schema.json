{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3-01 Medium Re-review",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_target", "verdict", "medium_resolved", "classifications", "findings", "gate_assessment", "recommended_next_action"],
  "properties": {
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "candidate_head", "candidate_pr"],
      "properties": {
        "repository": {"type": "string", "const": "dygapp/agentic-dev"},
        "candidate_head": {"type": "string", "const": "a6a61a41db762dc81d5105fe3d63ebba3d418c7e"},
        "candidate_pr": {"type": "integer", "const": 100}
      }
    },
    "verdict": {"type": "string", "enum": ["PASS", "REVISE", "REJECT"]},
    "medium_resolved": {"type": "boolean"},
    "classifications": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "semantic_owner", "confidence", "reason", "ambiguity"],
        "properties": {
          "path": {
            "type": "string",
            "enum": ["AGENTS.md", "docs/project/ai-review-guidelines.md", "tasks/README.md", "docs/project/project-roadmap.md"]
          },
          "semantic_owner": {
            "type": "string",
            "enum": ["仓库本地政策 / 规范 / 规则", "项目 / 产品权威资源", "混合正文，需按语义拆分", "模型缺少合适类别"]
          },
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "reason": {"type": "string", "minLength": 1},
          "ambiguity": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "failure_scenario", "evidence_refs", "minimal_fix"],
        "properties": {
          "severity": {"type": "string", "enum": ["Blocking", "Medium", "Low"]},
          "title": {"type": "string", "minLength": 1},
          "failure_scenario": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "minimal_fix": {"type": "string", "minLength": 1}
        }
      }
    },
    "gate_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_for_v3_02_audit", "reason"],
      "properties": {
        "ready_for_v3_02_audit": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "recommended_next_action": {"type": "string", "minLength": 1}
  }
}
