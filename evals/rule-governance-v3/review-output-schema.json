{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule Governance v3 GPT-6 Governance Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_target",
    "verdict",
    "dimension_verdicts",
    "findings",
    "ownership_assessment",
    "preservation_assessment",
    "complexity_assessment",
    "recommended_next_action"
  ],
  "properties": {
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_commit", "candidate_file"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "dygapp/agentic-dev"
        },
        "base_commit": {
          "type": "string",
          "minLength": 7
        },
        "candidate_file": {
          "type": "string",
          "const": "evals/rule-governance-v3/v3-candidate-review-package.md"
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "REVISE", "REJECT"]
    },
    "dimension_verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause_reframing",
        "ownership_model",
        "guide_skill_boundary",
        "repository_standard_boundary",
        "consumer_lifecycle",
        "analysis_sequence",
        "adr_gate",
        "agentic_dev_self_adoption",
        "metadata_discovery_deferral",
        "v1_v2_preservation"
      ],
      "properties": {
        "root_cause_reframing": {"$ref": "#/$defs/dimension"},
        "ownership_model": {"$ref": "#/$defs/dimension"},
        "guide_skill_boundary": {"$ref": "#/$defs/dimension"},
        "repository_standard_boundary": {"$ref": "#/$defs/dimension"},
        "consumer_lifecycle": {"$ref": "#/$defs/dimension"},
        "analysis_sequence": {"$ref": "#/$defs/dimension"},
        "adr_gate": {"$ref": "#/$defs/dimension"},
        "agentic_dev_self_adoption": {"$ref": "#/$defs/dimension"},
        "metadata_discovery_deferral": {"$ref": "#/$defs/dimension"},
        "v1_v2_preservation": {"$ref": "#/$defs/dimension"}
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "ownership_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories_sufficient",
        "missing_or_overlapping_categories",
        "likely_misclassified_current_resources",
        "guide_catch_all_risk",
        "skill_explosion_risk"
      ],
      "properties": {
        "categories_sufficient": {"type": "boolean"},
        "missing_or_overlapping_categories": {
          "type": "array",
          "items": {"type": "string"}
        },
        "likely_misclassified_current_resources": {
          "type": "array",
          "items": {"type": "string"}
        },
        "guide_catch_all_risk": {"type": "string", "minLength": 1},
        "skill_explosion_risk": {"type": "string", "minLength": 1}
      }
    },
    "preservation_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1_preserved", "v2_preserved", "highest_risk_regressions"],
      "properties": {
        "v1_preserved": {"type": "boolean"},
        "v2_preserved": {"type": "boolean"},
        "highest_risk_regressions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "complexity_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prematurely_frozen_elements",
        "correctly_deferred_elements",
        "plan_merge_or_split_suggestions",
        "simpler_direction"
      ],
      "properties": {
        "prematurely_frozen_elements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "correctly_deferred_elements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "plan_merge_or_split_suggestions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "simpler_direction": {
          "type": ["string", "null"]
        }
      }
    },
    "recommended_next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "REVISE", "REJECT"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "design_goal_violated",
        "failure_scenario",
        "affected_components",
        "evidence_refs",
        "minimal_fix"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["Blocking", "Medium", "Low"]
        },
        "title": {"type": "string", "minLength": 1},
        "design_goal_violated": {"type": "string", "minLength": 1},
        "failure_scenario": {"type": "string", "minLength": 1},
        "affected_components": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "minimal_fix": {"type": "string", "minLength": 1}
      }
    }
  }
}
